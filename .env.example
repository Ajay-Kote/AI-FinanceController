# =====================================================================
# FinControl AI — Environment Variables
# =====================================================================
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# Variables prefixed with VITE_ are exposed to the browser (frontend).
# Variables WITHOUT the VITE_ prefix are server-side only and must be
# set as Supabase Edge Function secrets (see README for instructions).
# =====================================================================

# ---------------------------------------------------------------------
# FRONTEND (browser-visible) — put these in your .env file
# ---------------------------------------------------------------------

# Your Supabase project URL.
# Get this from: Supabase Dashboard > Project Settings > API > Project URL
# Example: https://yourproject.supabase.co
VITE_SUPABASE_URL=https://yourproject.supabase.co

# Your Supabase anon (public) key.
# Get this from: Supabase Dashboard > Project Settings > API > Project API keys > anon public
# This is safe to expose in the browser — it only works with your RLS policies.
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ---------------------------------------------------------------------
# BACKEND (server-side secrets) — set these as Supabase Edge Function secrets
# ---------------------------------------------------------------------
# These are NOT read from .env at runtime. They must be set as Supabase
# Edge Function secrets so the deployed functions can access them:
#
#   npx supabase secrets set GEMINI_API_KEY=your_key_here
#   npx supabase secrets set RAZORPAY_KEY_ID=your_key_id_here
#   npx supabase secrets set RAZORPAY_KEY_SECRET=your_key_secret_here
#   npx supabase secrets set RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
#
# Or set them via the Supabase Dashboard > Edge Functions > Secrets.
# ---------------------------------------------------------------------

# Google Gemini API key — used by the ai-insights edge function to
# generate AI-powered answers about the user's finances.
# Get this from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Razorpay Key ID — used by the razorpay-payment and razorpay-refund edge
# functions to create orders, verify payments, and process refunds.
# Get this from: https://dashboard.razorpay.com/app/keys
# Use the TEST mode keys (starts with rzp_test_) for development.
RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Razorpay Key Secret — the secret paired with the Key ID above.
# NEVER expose this in the frontend. Only set it as a Supabase secret.
# Get this from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_SECRET=your_key_secret_here

# Razorpay Webhook Secret — used by the razorpay-webhook edge function to
# verify that webhook requests are genuinely from Razorpay.
# Get this from: Razorpay Dashboard > Settings > Webhooks
# After creating a webhook, copy the "Secret" value shown.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
